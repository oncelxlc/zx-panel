# Docker Compose 项目名；同一主机运行多个副本时请改成不同值。
COMPOSE_PROJECT_NAME=zx-panel

# 默认仅允许宿主机本地访问。确需局域网访问时可改为 0.0.0.0，并配置防火墙。
DOCKER_BIND_HOST=127.0.0.1

# PostgreSQL
POSTGRES_DB=zx_panel
POSTGRES_USER=zx_panel
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
POSTGRES_SSLMODE=disable

# Go 后端首次启动时使用；已有用户后不会覆盖现有管理员密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin

# 留空表示浏览器使用同源 /api；Vite 开发服务器会代理到本地 Go 后端。
VITE_API_BASE_URL=

# Redis
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379
