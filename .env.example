# Docker Compose 项目名；运行多个副本时还需调整固定容器名和宿主机端口。
COMPOSE_PROJECT_NAME=zx-panel

# 默认仅允许宿主机本地访问。确需局域网访问时可改为 0.0.0.0，并配置防火墙。
DOCKER_BIND_HOST=127.0.0.1

# PostgreSQL
POSTGRES_DB=zx_panel
POSTGRES_USER=zx_panel
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=25432
POSTGRES_HOST=127.0.0.1
POSTGRES_SSLMODE=disable

# 管理员通过本机 setup-token + /setup 初始化，不自动创建。

# 浏览器固定使用同源 /api；Vite 代理到本地 25000，显式 mock 模式才使用演示数据。
VITE_DATA_MODE=api

# Redis（原有可选开发服务；v1.1 面板不依赖 Redis）
REDIS_PASSWORD=change_me_redis
REDIS_PORT=26379
